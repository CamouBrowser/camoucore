{
  "name": "camoucore",
  "version": "0.1.0",
  "description": "The browser-independent core of the Camoufox and Camouwolf launchers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*.js": "./dist/*.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/copy-files.mjs",
    "test": "vitest run",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build"
  },
  "files": [
    "dist"
  ],
  "author": "JWriter20",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JWriter20/CamouCore.git",
    "directory": "typescript"
  },
  "engines": {
    "node": ">=22.15"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cli-progress": "^3.12.0",
    "language-tags": "^2.0.1",
    "maxmind": "^5.0.0",
    "pretty-bytes": "^7.1.0",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/cli-progress": "^3.11.6",
    "@types/language-tags": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/xml2js": "^0.4.14",
    "fpgen-js": "1.3.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "8.3.8",
    "vitest": "^4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.4",
      "onFail": "warn"
    }
  }
}
