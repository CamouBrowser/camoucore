{
  "name": "camoucore",
  "version": "0.6.2",
  "description": "The Camoufox and Camouwolf launchers, the core they share, and an MCP server that drives them",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./camoufox": "./dist/camoufox/index.js",
    "./camouwolf": "./dist/camouwolf/index.js",
    "./mcp": "./dist/mcp/index.js",
    "./package.json": "./package.json",
    "./*.js": "./dist/*.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc && node scripts/copy-files.mjs",
    "test": "pnpm build && vitest run",
    "test:core": "pnpm build && vitest run --project core",
    "test:camoufox": "pnpm build && vitest run --project camoufox",
    "test:camouwolf": "pnpm build && vitest run --project camouwolf",
    "test:mcp": "pnpm build && vitest run --project mcp",
    "test:watch": "vitest",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "prepare": "pnpm build",
    "check:pack": "node scripts/check-pack.mjs",
    "golden": "pnpm golden:camouwolf",
    "golden:camouwolf": "${CAMOUWOLF_PYTHON:-$HOME/.cache/camouwolf-venv/bin/python} scripts/camouwolf/golden/launch_golden.py"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "camoufox",
    "camouwolf",
    "firefox",
    "chromium",
    "playwright",
    "fingerprint",
    "anti-detect",
    "scraping",
    "mcp"
  ],
  "author": "JWriter20",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CamouBrowser/camoucore.git",
    "directory": "typescript/camoucore"
  },
  "bugs": {
    "url": "https://github.com/CamouBrowser/camoucore/issues"
  },
  "engines": {
    "node": ">=22.15"
  },
  "//engines": "22.15 for node:zlib zstd, which the fpgen model archive needs.",
  "//playwright-core": "Range mirrors python/camoucore/pyproject.toml's `playwright = \"<1.63\"`: every Playwright minor is free to change Juggler, so the ceiling is bumped deliberately, with a run of `make -C browser tests`. The dev pin (1.62.0) is the version the Python venv resolves, so the goldens compare like with like.",
  "//@jwriter20/myuri": "Pinned to the release python/camoucore/pyproject.toml pins, so a humanize seed plans the same input in both languages.",
  "//fpgen-js": "Pinned with the fpgen model pin (python/camoucore/src/camoucore/fpgen-model.json).",
  "dependencies": {
    "@jwriter20/myuri": "5.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "adm-zip": "^0.6.1",
    "cli-progress": "^3.12.0",
    "commander": "^14.0.0",
    "fpgen-js": "1.3.0",
    "impit": "^0.14.1",
    "language-tags": "^2.0.1",
    "maxmind": "^5.0.0",
    "pretty-bytes": "^7.1.0",
    "python-random": "1.0.0",
    "ua-parser-js": "^2.0.2",
    "xml2js": "^0.6.2",
    "yaml": "^2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@types/cli-progress": "^3.11.6",
    "@types/language-tags": "^1.0.4",
    "@types/node": "^24.0.0",
    "@types/xml2js": "^0.4.14",
    "playwright-core": "1.62.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "8.3.8",
    "vitest": "^4.0.0"
  },
  "peerDependencies": {
    "playwright-core": "<1.63"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.4",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
